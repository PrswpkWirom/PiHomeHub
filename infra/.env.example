PIHOMEHUB_SECRET_KEY=
PIHOMEHUB_CONTROL_AGENT_SECRET=
PIHOMEHUB_PUBLIC_BASE_URL=https://your-pi.your-tailnet.ts.net
PIHOMEHUB_ALLOWED_ORIGINS=https://your-pi.your-tailnet.ts.net
PIHOMEHUB_INGRESS_BIND_ADDRESS=127.0.0.1
PIHOMEHUB_HTTPS_PORT=443
# If Tailscale Serve reaches Caddy through Docker's host gateway, set its exact
# address here (normally 172.30.0.1 for the bundled edge network).
PIHOMEHUB_TRUSTED_INGRESS_PROXY_IPS=127.0.0.1 ::1
PIHOMEHUB_BIND_ADDRESS=127.0.0.1
ADGUARD_WEB_PORT=3001
ADGUARD_DNS_PORT=53
GITEA_HTTP_PORT=3002
GITEA_SSH_PORT=2222
UPTIME_KUMA_HTTP_PORT=3003
VAULTWARDEN_HTTP_PORT=3004
MOSQUITTO_MQTT_PORT=1883
# Numeric group ID of the host group that owns /var/run/docker.sock.
DOCKER_GID=999
