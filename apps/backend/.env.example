PIHOMEHUB_ENV=development
PIHOMEHUB_SECRET_KEY=
PIHOMEHUB_CONTROL_AGENT_SECRET=
PIHOMEHUB_DATABASE_URL=sqlite:///./pihomehub.db
PIHOMEHUB_ADMIN_USERNAME=
PIHOMEHUB_ADMIN_PASSWORD=
PIHOMEHUB_PUBLIC_BASE_URL=http://localhost:5173
PIHOMEHUB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PIHOMEHUB_SESSION_IDLE_TIMEOUT_SECONDS=43200
PIHOMEHUB_SESSION_ABSOLUTE_TIMEOUT_SECONDS=604800
PIHOMEHUB_RECENT_AUTHENTICATION_SECONDS=600
PIHOMEHUB_CONTROL_AGENT_URL=http://control-agent:9000
PIHOMEHUB_MONITORED_SERVICES=adguard-home,gitea,uptime-kuma,vaultwarden,mosquitto
PIHOMEHUB_HOST_PROC_NET_PATH=/proc/net
PIHOMEHUB_HOST_MEMINFO_PATH=/proc/meminfo
PIHOMEHUB_HOST_THERMAL_PATH=/sys/class/thermal/thermal_zone0/temp
PIHOMEHUB_HOST_ROOT_PROBE_PATH=/
PIHOMEHUB_NOTIFICATION_MONITOR_INTERVAL_SECONDS=30
PIHOMEHUB_NOTIFICATION_OFFLINE_FAILURES=3
PIHOMEHUB_NOTIFICATION_RECOVERY_SUCCESSES=2
PIHOMEHUB_NOTIFICATION_TEMPERATURE_HIGH_C=75
PIHOMEHUB_NOTIFICATION_TEMPERATURE_RECOVERY_C=70
PIHOMEHUB_NOTIFICATION_TEMPERATURE_DURATION_SECONDS=300
PIHOMEHUB_NOTIFICATION_DISK_WARNING_PERCENT=85
PIHOMEHUB_NOTIFICATION_DISK_CRITICAL_PERCENT=95
PIHOMEHUB_NOTIFICATION_DISK_DEGRADED_PERCENT=90
PIHOMEHUB_NOTIFICATION_DISK_RECOVERY_PERCENT=80
PIHOMEHUB_NOTIFICATION_DISK_DURATION_SECONDS=120
PIHOMEHUB_NOTIFICATION_MEMORY_HIGH_PERCENT=90
PIHOMEHUB_NOTIFICATION_MEMORY_RECOVERY_PERCENT=85
PIHOMEHUB_NOTIFICATION_MEMORY_DURATION_SECONDS=300
PIHOMEHUB_NOTIFICATION_METRIC_RECOVERY_SECONDS=120
PIHOMEHUB_SERVICE_LINKS_JSON=[]
PIHOMEHUB_KNOWN_DEVICES_JSON=[]
